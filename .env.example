# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Werte in .env haben Vorrang vor den Einstellungen in der App (data/config.json).
# Alles ist optional: Ohne Schlüssel läuft die App im Demo-Modus.

PORT=3000

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Aufwand der KI (low | medium | high). medium reicht fast immer.
CLAUDE_EFFORT=medium
# Automatischer Ersatzmodell-Mechanismus bei Ablehnungen (on | off)
CLAUDE_FALLBACK=on

# eBay Developer Portal - https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CERT_ID=
EBAY_RU_NAME=
# sandbox oder production
EBAY_ENV=sandbox

# Öffentliche Basis-Adresse der App (nur für Hinweise in der Einstellungsseite)
# PUBLIC_URL=http://localhost:3000

# Demo-Modus erzwingen (true), auch wenn Schlüssel vorhanden sind
# DEMO_MODE=false

# Hochgeladene Bilder nach so vielen Stunden automatisch löschen
CLEANUP_HOURS=48
